{
  "name": "agentusagev2",
  "version": "0.2.0",
  "private": true,
  "description": "Windows taskbar companion for AI subscription usage",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.jun6558.agentusagev2",
    "productName": "AgentUsageV2",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [{ "from": "README.md", "to": "README.md" }],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentUsageV2"
    }
  }
}
